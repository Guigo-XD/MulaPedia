---
// Search com Pagefind UI
---

<div class="search-wrap">
  <div id="search"></div>
</div>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>

<script is:inline>
  (function () {
    function boot() {
      if (typeof PagefindUI === "undefined") {
        console.error("PagefindUI não carregou. Rode: npm run search:index");
        return;
      }
      const el = document.getElementById("search");
      if (!el) return;
      // evita iniciar 2 vezes
      if (el.dataset.pf === "1") return;
      el.dataset.pf = "1";

      new PagefindUI({
        element: "#search",
        showImages: false,
        showSubResults: true,
        translations: {
          placeholder: "Pesquisar na MulaPédia...",
          clear_search: "Limpar",
          load_more: "Carregar mais",
          search_label: "Buscar",
          zero_results: "Nenhum resultado para [SEARCH_TERM]",
        },
      });
    }

    if (document.readyState === "complete" || document.readyState === "interactive") {
      setTimeout(boot, 50);
    } else {
      document.addEventListener("DOMContentLoaded", boot);
    }
  })();
</script>

<style is:global>
  .search-wrap {
    flex: 1;
    max-width: 420px;
    margin: 0 24px;
    min-width: 200px;
  }

  /* Garante que o campo apareça */
  #search,
  .pagefind-ui,
  .pagefind-ui__form,
  .pagefind-ui__search-input {
    display: block !important;
    width: 100% !important;
  }

  .pagefind-ui {
    --pagefind-ui-primary: #3b82f6;
    --pagefind-ui-text: #e5e7eb;
    --pagefind-ui-background: #1e293b;
    --pagefind-ui-border: #334155;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: Inter, system-ui, sans-serif;
  }

  .pagefind-ui__search-input {
    background: #1e293b !important;
    color: #fff !important;
    height: 42px !important;
  }
</style>