---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const latestArticles = (await getCollection('pages'))
  .sort((a, b) => {
    const da = a.data.updatedDate ? new Date(a.data.updatedDate).getTime() : 0;
    const db = b.data.updatedDate ? new Date(b.data.updatedDate).getTime() : 0;
    return db - da;
  })
  .slice(0, 4);

function sectionEmoji(section?: string) {
  if (section === 'G3X') return '🎮';
  if (section === 'Kings League') return '👑';
  if (section === 'CS2') return '🔫';
  if (section === 'Gaules') return '🎙️';
  if (section === 'Tribo') return '❤️';
  return '📄';
}
---

<Layout title="Início">
<div data-pagefind-body>

 <!-- Hero -->
<section class="hero">
  <img
    class="hero-bg"
    src="/hero/tribo-hero.jpg"
    alt=""
  />
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-content">
      <h2>Mula<span>Pédia</span></h2>
      <p>
        A enciclopédia não oficial da Tribo — G3X, Kings League, CS2, Gaules
        e a maior comunidade do Brasil.
      </p>
      <div class="hero-badge">👑 A Tribo cuida da Tribo</div>
    </div>

    <div class="hero-tags">
      <span>INFORMAÇÃO</span>
      <span>JOGO</span>
      <span>COMUNIDADE</span>
      <span>TRIBO 👑</span>
    </div>
  </div>
</section>

<!-- Principais áreas -->
<section>  
  <div class="section-header">
    <h3>⭐ Principais áreas</h3>
    <a href="/areas">Ver todas as áreas →</a>
  </div>

  <div class="cards-grid">

  <div class="card">
    <a href="/g3x/historia" class="card-img-link">
      <img src="/cards/g3x.jpg" alt="G3X" class="card-photo" />    
    </a>
    <div class="card-body">
      <a href="/g3x/historia"><h4>G3X</h4></a>
      <p>Fundado em 2001 por Gaules no CS 1.6. Hoje é o time do povo na Kings League e campeão mundial 2026.</p>
      <div class="card-links">
        <a href="/g3x/historia">📄 História →</a>
        <a href="/g3x/titulos">🏆 Títulos →</a>
        <a href="/g3x/resultados">📊 Resultados →</a>
      </div>
    </div>
  </div>

  <div class="card">
    <a href="/kings-league/overview" class="card-img-link">
      <img src="/cards/kl.jpg" alt="Kings League" class="card-photo" />
    </a>
    <div class="card-body">
      <a href="/kings-league/overview"><h4>Kings League</h4></a>
      <p>Futebol 7 + entretenimento. G3X FC foi campeão da Kings World Cup Clubs 2026 em Milão (9×5 Alpak).</p>
      <div class="card-links">
        <a href="/kings-league/overview">📜 Visão geral →</a>
        <a href="/g3x/resultados">📊 Resultados →</a>
        <a href="/g3x/elenco">👥 Elenco G3X →</a>
      </div>
    </div>
  </div>

  <div class="card">
    <a href="/cs2/overview" class="card-img-link">
      <img src="/cards/cs2.jpg" alt="Counter-Strike 2" class="card-photo" />
    </a>
    <div class="card-body">
      <a href="/cs2/overview"><h4>Counter-Strike 2</h4></a>
      <p>O FPS que move a Tribo. Gaules transmite diariamente e já montou dream team com FalleN, KSCERATO e mais.</p>
      <div class="card-links">
        <a href="/cs2/overview">📘 Visão geral →</a>
        <a href="/cs2/mapas">🗺️ Mapas →</a>
        <a href="/gaules/biografia">🎙️ Gaules →</a>
      </div>
    </div>
  </div>

  <div class="card">
    <a href="/tribo/cultura" class="card-img-link">
      <img src="/cards/tribo.jpg" alt="Universo da Tribo" class="card-photo" />
    </a>
    <div class="card-body">
      <a href="/tribo/cultura"><h4>Universo da Tribo</h4></a>
      <p>Gaules, Liminha, BT, Apoka, BIA, Velho Vamp e milhões de mulas. Cultura, memes e “A Tribo cuida da Tribo”.</p>
      <div class="card-links">
        <a href="/gaules/biografia">🎙️ Gaules →</a>
        <a href="/glossario">💬 Bordões →</a>
        <a href="/tribo/cultura">❤️ Cultura →</a>
        <a href="/tribo/socio-sofredor">🎫 Sócio Sofredor →</a>
      </div>
    </div>
  </div>

</div>
</section>

  <!-- Últimos artigos -->
  <section>
  <div class="section-header">
    <h3>📄 Últimos artigos</h3>
    <a href="/artigos">Ver todos os artigos →</a>
  </div>

  <div class="articles-grid">
    {latestArticles.map((article) => (
      <a href={`/${article.id}`} class="article-card">
        <div
          class="article-img"
          style="background:linear-gradient(135deg,#1e293b,#0f172a);"
        >
          {sectionEmoji(article.data.section)}
        </div>
        <div class="article-body">
          <h5>{article.data.title}</h5>
          <p>{article.data.description || 'Artigo da MulaPédia'}</p>
          <div class="article-date">
            {article.data.section || 'Geral'}
            {article.data.updatedDate &&
              ` · ${new Date(article.data.updatedDate).toLocaleDateString('pt-BR')}`}
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
</div>
</Layout>